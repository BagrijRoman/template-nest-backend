# Runtime environment: development | production | test (default: development)
NODE_ENV=development

# Port the HTTP server listens on (default: 3000)
PORT=3000

# Pino log level: trace | debug | info | warn | error | fatal | silent (default: info, silent under test)
LOG_LEVEL=info

# MongoDB connection string (mongodb:// or mongodb+srv://)
MONGODB_URI=mongodb://localhost:27017/template-backend

# Secret for signing JWT access tokens — at least 32 characters, e.g. `openssl rand -hex 32` (required, no default)
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-32-plus-characters

# Access token lifetime: number + unit (ms|s|m|h|d)
JWT_ACCESS_TTL=15m

# Secret for signing/hashing JWT refresh tokens — at least 32 characters, must differ from the access secret (required, no default)
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-32-plus-characters

# Refresh token lifetime: number + unit (ms|s|m|h|d)
JWT_REFRESH_TTL=30d

# Comma-separated whitelist of browser origins allowed by CORS; unset = CORS disabled. Never use "*".
# CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Check new passwords against haveibeenpwned (k-anonymity range API; only a 5-char sha1 prefix
# leaves the server). "enabled" (default) or "disabled"; fails open when the API is unreachable.
# BREACHED_PASSWORD_CHECK=enabled
